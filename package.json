{
  "name": "grok-image-mcp",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "grok-image-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "watch": "tsc --watch",
    "start": "node ./dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "grok",
    "xai",
    "image-generation",
    "image-editing",
    "model-context-protocol",
    "grok-imagine-image"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fl0w1nd/grok-image-mcp"
  },
  "author": "fl0w1nd",
  "license": "MIT",
  "description": "MCP server for Grok image generation and editing via xAI API",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
